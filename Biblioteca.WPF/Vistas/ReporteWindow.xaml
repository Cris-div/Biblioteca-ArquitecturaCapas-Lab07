<Window x:Class="Biblioteca.WPF.Vistas.ReporteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de préstamos" Height="560" Width="1060"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Background="{StaticResource Fondo}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Encabezado}">
            <TextBlock Text="Reporte de préstamos por intervalo de fechas" Style="{StaticResource Titulo}" />
        </Border>
        <Border x:Name="contenido" Style="{StaticResource Tarjeta}" Margin="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="dpDesde" Width="140" />
                    <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <DatePicker x:Name="dpHasta" Width="140" />
                    <Button x:Name="btnGenerar" Content="Generar reporte" Click="BtnGenerar_Click" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="txtResumen" Margin="0,8,0,0" Foreground="#666" />
                <DataGrid x:Name="dgReporte">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId}" Width="75" />
                        <DataGridTextColumn Header="Socio" Binding="{Binding SocioNombre}" Width="*" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding LibroTitulo}" Width="1.5*" />
                        <DataGridTextColumn Header="F. préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="95" />
                        <DataGridTextColumn Header="F. límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="90" />
                        <DataGridTextColumn Header="Estado préstamo" Binding="{Binding Estado}" Width="120" />
                        <DataGridTextColumn Header="F. devolución" Binding="{Binding FechaDevolucion, StringFormat=dd/MM/yyyy}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
