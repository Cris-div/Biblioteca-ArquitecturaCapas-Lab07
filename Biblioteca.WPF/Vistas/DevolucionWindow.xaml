<Window x:Class="Biblioteca.WPF.Vistas.DevolucionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devolución de libros" Height="560" Width="1040"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Background="{StaticResource Fondo}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Encabezado}">
            <TextBlock Text="Devolución de libros" Style="{StaticResource Titulo}" />
        </Border>
        <Grid x:Name="contenido" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" x:Name="btnActualizar" Content="Actualizar" Click="BtnActualizar_Click" Style="{StaticResource BotonSecundario}" Margin="0" />
                        <TextBlock Text="Libros pendientes de devolución" Style="{StaticResource Subtitulo}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="txtTotal" Margin="0,8,0,0" Foreground="#666" />
                    <DataGrid x:Name="dgPendientes" SelectionChanged="DgPendientes_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId}" Width="75" />
                            <DataGridTextColumn Header="Socio" Binding="{Binding SocioNombre}" Width="*" />
                            <DataGridTextColumn Header="Libro" Binding="{Binding LibroTitulo}" Width="1.4*" />
                            <DataGridTextColumn Header="F. préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="95" />
                            <DataGridTextColumn Header="F. límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Registrar devolución" Style="{StaticResource Subtitulo}" />
                    <TextBlock Text="Libro seleccionado" Style="{StaticResource Etiqueta}" Margin="0,0,0,3" />
                    <Border Background="#EEF3FA" CornerRadius="4" Padding="8,6">
                        <TextBlock x:Name="txtSeleccion" Text="(ninguno)" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Fecha de devolución" Style="{StaticResource Etiqueta}" />
                    <DatePicker x:Name="dpFechaDevolucion" />
                    <Button x:Name="btnDevolver" Content="Registrar devolución" Click="BtnDevolver_Click"
                            Style="{StaticResource BotonExito}" Margin="0,14,0,0" HorizontalAlignment="Left" />

                    <Border x:Name="panelMulta" Margin="0,20,0,0" Padding="12" CornerRadius="6" Background="#FDF2E9"
                            BorderBrush="#E59866" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Multa calculada" Foreground="#935116" FontWeight="SemiBold" />
                            <TextBlock x:Name="txtMulta" FontSize="28" FontWeight="Bold" Foreground="#935116" Margin="0,2,0,4" />
                            <TextBlock x:Name="txtDetalleMulta" TextWrapping="Wrap" Foreground="#6E2C00" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
