<Window x:Class="Biblioteca.WPF.Vistas.LibrosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento de libros" Height="560" Width="1020"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Background="{StaticResource Fondo}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Encabezado}">
            <TextBlock Text="Mantenimiento de libros" Style="{StaticResource Titulo}" />
        </Border>
        <Grid x:Name="contenido" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Buscar por título o autor:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" x:Name="btnBuscar" Content="Buscar" Click="BtnBuscar_Click" Margin="6,0,0,0" IsDefault="True" />
                        <TextBox x:Name="txtFiltro" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="txtTotal" Margin="0,8,0,0" Foreground="#666" />
                    <DataGrid x:Name="dgLibros" SelectionChanged="DgLibros_SelectionChanged" RowStyle="{StaticResource FilaConEstado}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding LibroId}" Width="45" />
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="2*" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding NombreAutor}" Width="1.5*" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120" />
                            <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="85" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Activo, Converter={StaticResource EstadoConverter}}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock x:Name="txtModo" Text="Nuevo libro" Style="{StaticResource Subtitulo}" />
                    <TextBlock Text="Título" Style="{StaticResource Etiqueta}" />
                    <TextBox x:Name="txtTitulo" MaxLength="180" />
                    <TextBlock Text="ISBN" Style="{StaticResource Etiqueta}" />
                    <TextBox x:Name="txtIsbn" MaxLength="20" />
                    <TextBlock Text="Autor" Style="{StaticResource Etiqueta}" />
                    <ComboBox x:Name="cboAutor" DisplayMemberPath="Nombre" SelectedValuePath="AutorId" />
                    <TextBlock Text="Ejemplares" Style="{StaticResource Etiqueta}" />
                    <TextBox x:Name="txtEjemplares" MaxLength="5" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="btnGuardar" Content="Guardar" Click="BtnGuardar_Click" Style="{StaticResource BotonExito}" Margin="0,0,6,6" />
                        <Button x:Name="btnNuevo" Content="Nuevo" Click="BtnNuevo_Click" Style="{StaticResource BotonSecundario}" Margin="0,0,6,6" />
                        <Button x:Name="btnEliminar" Content="Dar de baja" Click="BtnEliminar_Click" Style="{StaticResource BotonPeligro}" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
